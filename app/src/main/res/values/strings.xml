<?xml version="1.0" encoding="utf-8"?>
<!--
  Interface copy.

  Written from the user's side of the screen: things are named by what a person
  controls, not by how the system is built. "Notification access is off" rather than
  "NotificationListenerService unbound". Sentence case throughout, active voice, and an
  action keeps the same name from the control that starts it through to whatever
  reports it finished.

  The empty state is an invitation rather than a dead end — it names the two things
  that actually make the agent start working.
-->
<resources>
    <string name="app_name">MobileClaw</string>

    <!-- Agent run state -->
    <string name="state_running">Running</string>
    <string name="state_paused">Paused</string>
