<?xml version="1.0" encoding="utf-8"?>
<!--
  The type scale.

  Two families with a clear division of labour: Plex Sans for anything a person wrote
  or the assistant said, Plex Mono for anything the machine reported. Sizes are set so
  the interface stays legible when a screenshot is scaled into one column of a
  two-column paper (~3.3in), which is smaller than it sounds — hence a 15sp body rather
  than the 14sp the layouts used before, and no text below 11sp anywhere.

  Letter spacing is in ems. Negative tracking on large text and positive tracking on
  small uppercase labels is the single cheapest thing that makes type look set rather
  than merely placed.
-->
<resources>

    <!-- ===== Display / titles ===== -->
    <style name="Text.Wordmark" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/plex_sans</item>
        <item name="fontFamily">@font/plex_sans</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">19sp</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Text.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/plex_sans</item>
        <item name="fontFamily">@font/plex_sans</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Section eyebrow. Uppercase + wide tracking, used to label regions of a screen
         (SETUP, TODAY, PENDING). Small enough to never compete with content. -->
    <style name="Text.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/plex_sans</item>
        <item name="fontFamily">@font/plex_sans</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- ===== Body ===== -->
    <style name="Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/plex_sans</item>
        <item name="fontFamily">@font/plex_sans</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Text.Body.Muted">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- ===== Machine output ===== -->
    <style name="Text.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/plex_mono</item>
        <item name="fontFamily">@font/plex_mono</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- The head of an autonomous event on the rail: time, app, sender. -->
    <style name="Text.Mono.Strong">
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Token costs, confidences, timestamps — present but never competing. -->
    <style name="Text.Mono.Faint">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/mc_ink_faint</item>
    </style>

    <!-- ===== Controls ===== -->
    <style name="Text.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/plex_sans</item>
        <item name="fontFamily">@font/plex_sans</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.005</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
