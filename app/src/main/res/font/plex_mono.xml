<?xml version="1.0" encoding="utf-8"?>
<!--
  IBM Plex Mono, SIL OFL 1.1.

  The mono face is not decoration. This app displays a lot of genuine machine output —
  package names, tool names, token counts, confidence scores, RSS figures, timestamps —
  and setting those in mono while prose stays in Plex Sans encodes the difference
  between what the system reports and what it says. That distinction is the whole
  reason the timeline is readable at a glance.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/ibm_plex_mono_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/ibm_plex_mono_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/ibm_plex_mono_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/ibm_plex_mono_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

</font-family>
