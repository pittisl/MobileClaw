<?xml version="1.0" encoding="utf-8"?>
<!--
  IBM Plex Sans, SIL OFL 1.1. Bundled rather than loaded through the downloadable-fonts
  provider on purpose: the demo runs on phones that may have no network and no Play
  Services, and a font that silently falls back to Roboto on the conference floor would
  undo the whole design.

  Weights are declared in both namespaces so AppCompat resolves them below API 28.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/ibm_plex_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/ibm_plex_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/ibm_plex_sans_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/ibm_plex_sans_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

    <font
        android:font="@font/ibm_plex_sans_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/ibm_plex_sans_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />

</font-family>
