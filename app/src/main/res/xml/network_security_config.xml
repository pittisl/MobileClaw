<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP is allowed to the loopback interface only, for a model server running
     on the phone itself or forwarded onto it with `adb reverse`. 10.0.2.2 is the
     emulator's alias for its host. Everything else keeps the platform default of TLS-only,
     so a cloud endpoint typed without https:// still fails rather than downgrading. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
