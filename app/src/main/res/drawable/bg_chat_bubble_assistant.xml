<?xml version="1.0" encoding="utf-8"?>
<!-- Assistant bubble. The bottom-start corner is squared while the others are round:
     the flat corner points at the speaker, which is what makes a bubble read as
     attributed without needing a tail. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainerLow" />
    <stroke android:width="1dp" android:color="?attr/colorOutlineVariant" />
    <corners
        android:topLeftRadius="@dimen/radius_bubble"
        android:topRightRadius="@dimen/radius_bubble"
        android:bottomRightRadius="@dimen/radius_bubble"
        android:bottomLeftRadius="@dimen/radius_sm" />
</shape>
