<?xml version="1.0" encoding="utf-8"?>
<!--
  The MobileClaw mark.

  Three arcs swept from the lower-left corner. The form is deliberately double-read:
  it is a claw swipe and it is a signal fan, which is exactly what the product is — an
  agent that watches incoming signals and takes hold of them. Angled diagonally rather
  than pointing up, so it does not simply read as a wifi glyph.

  Stroked rather than filled, with round caps, so it survives being scaled to 20dp in
  the app bar and stays legible in a greyscale paper figure.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorPrimary">
    <path
        android:pathData="M3,15 A6,6 0 0 1 9,21"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M3,10 A11,11 0 0 1 14,21"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M3,5 A16,16 0 0 1 19,21"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />
</vector>
