<?xml version="1.0" encoding="utf-8"?>
<!-- The timeline well includes one continuous trace rail, drawn across its full
     height so sparse timeline entries do not leave disconnected rail segments. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceVariant" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
    <item
        android:left="@dimen/rail_inset"
        android:top="@dimen/sp_2"
        android:bottom="@dimen/sp_2"
        android:width="@dimen/rail_width"
        android:gravity="left|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorOutlineVariant" />
        </shape>
    </item>
</layer-list>
