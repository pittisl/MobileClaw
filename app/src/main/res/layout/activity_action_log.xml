<?xml version="1.0" encoding="utf-8"?>
<!--
  Action history — the audit trail of everything the agent actually did.

  This screen is worth showing in the paper: it is the accountability half of the
  confirm gate. The gate asks before acting; this records what happened afterwards,
  including the actions that were dropped un-run because nobody could be asked.

  Colour literals (#888888, #33000000) are gone — they were invisible in dark mode.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <include layout="@layout/include_screen_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="@dimen/sp_3">


        <!-- Says how much of the trail is on screen. The flow carries a window; the
             database holds far more, and a list that quietly stops is worse than one
             that says where it stopped. -->
        <TextView
            android:id="@+id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/Text.Mono.Faint"
            tools:text="showing 200 of 1,482 · 90-day retention" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/failuresOnly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_2"
            android:minHeight="0dp"
            android:paddingStart="@dimen/sp_2"
            android:text="Failures only"
            android:textAppearance="@style/Text.Body.Muted" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="?attr/colorOutlineVariant" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/sp_2"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/sp_8"
            android:gravity="center"
            android:textAppearance="@style/Text.Body.Muted"
            android:visibility="gone"
            tools:text="No actions recorded yet." />
    </FrameLayout>

</LinearLayout>
